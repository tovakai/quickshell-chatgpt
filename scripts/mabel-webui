#!/usr/bin/env python3
"""Open/close the ORIGINAL Mabel WebUI in a narrow Chromium app window.

This script is only a browser launcher and Hyprland window manager helper.
It never speaks to the Odysseus API, Strata or any inference endpoint.
"""
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import time
from urllib.parse import urlsplit


def mabel_url():
    url = os.environ.get("MABEL_URL", "http://127.0.0.1:7000").strip().rstrip("/")
    parsed = urlsplit(url)
    if parsed.scheme not in ("http", "https") or not parsed.hostname or parsed.username or parsed.password:
        raise ValueError("MABEL_URL must point to the actual Mabel WebUI over HTTP(S)")
    return url


def browser():
    requested = os.environ.get("MABEL_BROWSER", "").strip()
    if requested:
        result = shutil.which(requested)
        if result:
            return result
        raise RuntimeError("MABEL_BROWSER executable unavailable: " + requested)
    for name in ("chromium", "chromium-browser", "google-chrome-stable", "google-chrome", "brave"):
        result = shutil.which(name)
        if result:
            return result
    raise RuntimeError("Install Chromium with 'sudo pacman -S chromium' or set MABEL_BROWSER")


def profile():
    data = Path(os.environ.get("XDG_DATA_HOME") or str(Path.home() / ".local/share"))
    return Path(os.environ.get("MABEL_WEBUI_PROFILE") or str(data / "mabel-webui" / "chromium")).expanduser().resolve()


def command(executable, url, data_dir):
    return [executable, "--app=" + url, "--user-data-dir=" + str(data_dir),
            "--no-first-run", "--no-default-browser-check", "--disable-background-mode",
            "--window-size=480,900", "--class=MabelWebUI"]


def hypr_json(kind):
    raw = subprocess.run(["hyprctl", "-j", kind], check=True, capture_output=True, text=True)
    return json.loads(raw.stdout)


def dispatch(verb, argument):
    subprocess.run(["hyprctl", "dispatch", verb, argument], check=True,
                   capture_output=True, text=True)


def _profile_owner(pid, data_dir):
    if not isinstance(pid, int) or pid < 1:
        return False
    try:
        arguments = Path("/proc").joinpath(str(pid), "cmdline").read_bytes().decode("utf-8", "replace").split("\0")
    except OSError:
        return False
    return "--user-data-dir=" + str(data_dir) in arguments


def matches(window, data_dir, url):
    if not isinstance(window, dict) or not window.get("address"):
        return False
    clazz = str(window.get("class") or window.get("initialClass") or "").lower()
    if clazz == "mabelwebui" or _profile_owner(window.get("pid"), data_dir):
        return True
    # Native Wayland Chromium ignores --class and invents an app_id based on URL.
    # Only accept a browser app window for THIS origin, not an ordinary browser tab.
    hostname = (urlsplit(url).hostname or "").lower().replace(".", "_")
    normalized = clazz.replace(".", "_")
    title = str(window.get("title") or window.get("initialTitle") or "")
    app_class = "-" in clazz and any(key in clazz for key in ("chrome", "chromium", "brave"))
    return app_class and hostname in normalized and "Odysseus" in title


def find_window(data_dir, url):
    return next((w for w in hypr_json("clients") if matches(w, data_dir, url)), None)


def geometry(monitor):
    scale = max(float(monitor.get("scale") or 1), .1)
    width = int(monitor["width"] / scale)
    height = int(monitor["height"] / scale)
    win_width = min(480, width - 32)
    win_height = height - 54
    return (int(monitor["x"] + width - win_width - 16),
            int(monitor["y"] + 38), win_width, win_height)


def move_to_right(window):
    address = "address:" + str(window["address"])
    if not window.get("floating"):
        dispatch("togglefloating", address)
    monitors = hypr_json("monitors")
    if not monitors:
        return
    monitor = next((m for m in monitors if m.get("focused")), monitors[0])
    x, y, width, height = geometry(monitor)
    dispatch("resizewindowpixel", "exact " + str(width) + " " + str(height) + "," + address)
    dispatch("movewindowpixel", "exact " + str(x) + " " + str(y) + "," + address)
    dispatch("focuswindow", address)


def launch(data_dir, url):
    data_dir.mkdir(parents=True, exist_ok=True, mode=0o700)
    os.chmod(data_dir, 0o700)
    subprocess.Popen(command(browser(), url, data_dir), stdin=subprocess.DEVNULL,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     start_new_session=True)
    for _ in range(48):
        time.sleep(.125)
        window = find_window(data_dir, url)
        if window:
            move_to_right(window)
            return
    raise RuntimeError("Could not identify the browser window. Inspect 'hyprctl clients -j' for its class/app_id")


def main(argv=None):
    args = list(sys.argv[1:] if argv is None else argv)
    verb = args[0] if args else "toggle"
    if verb not in ("toggle", "open", "close"):
        print("usage: mabel-webui [toggle|open|close]", file=sys.stderr)
        return 2
    try:
        if not shutil.which("hyprctl"):
            raise RuntimeError("Hyprland is required")
        url, data_dir = mabel_url(), profile()
        existing = find_window(data_dir, url)
        if existing and verb in ("toggle", "close"):
            dispatch("closewindow", "address:" + str(existing["address"]))
        elif existing:
            move_to_right(existing)
        elif verb != "close":
            launch(data_dir, url)
        return 0
    except (ValueError, RuntimeError, OSError, subprocess.CalledProcessError) as exc:
        print("mabel-webui: " + str(exc), file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
